# =============================================================================
# ESQUEL ACTIVO — Variables de Entorno
# Copia este archivo como .env.local y completa los valores reales.
# NUNCA subas el archivo .env o .env.local al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/esquel_activo"

# -----------------------------------------------------------------------------
# AUTENTICACIÓN (Auth.js v5)
# NEXTAUTH_SECRET: Clave aleatoria para firmar tokens. Generá una con:
#   openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# WHATSAPP CLOUD API (Meta)
# Se obtiene desde el panel de Meta for Developers → WhatsApp → API Setup
# -----------------------------------------------------------------------------
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""   # Token secreto que vos elegís para verificar el webhook

# -----------------------------------------------------------------------------
# EMAIL (SMTP)
# Podés usar Gmail, Resend, SendGrid, etc.
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@esquel-activo.com.ar"

# -----------------------------------------------------------------------------
# MERCADO PAGO (Preparación para Split Payments — Fase 5)
# Credenciales globales de la PLATAFORMA, no de los comercios.
# Cada comercio tendrá las suyas propias en la tabla Tenant de la DB.
# -----------------------------------------------------------------------------
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""

# -----------------------------------------------------------------------------
# DOMINIO DE LA PLATAFORMA
# Usado por el middleware para resolver tenants por subdominio.
# Ejemplo: si PLATFORM_DOMAIN=esquel-activo.com.ar, entonces
#   comercio1.esquel-activo.com.ar → tenant "comercio1"
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PLATFORM_DOMAIN="esquel-activo.com.ar"

# -----------------------------------------------------------------------------
# URLs INTERNAS DE LAS APPS (para comunicación entre servicios)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SHELL_URL="http://localhost:3000"
NEXT_PUBLIC_MARKETPLACE_URL="http://localhost:3001"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3002"
